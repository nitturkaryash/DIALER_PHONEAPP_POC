{
  "meta": {
    "profile_name": "mobile-analytics-dashboard",
    "version": "1.0.0",
    "intent": "Reusable design-system contract for generating consistent mobile analytics and reporting UIs without copying source-screen content.",
    "platform": "mobile",
    "content_policy": "Style and structure only. Never reproduce literal labels, names, numbers, or layout coordinates from reference screenshots."
  },
  "style_principles": {
    "aesthetic": [
      "minimalist",
      "data-first",
      "high-whitespace",
      "soft-contrast",
      "modern-geometric"
    ],
    "visual_themes": {
      "light_analytics": {
        "description": "Off-white or pale gradient canvas with white or frosted surfaces and a single high-saturation accent for highlights.",
        "effects": ["subtle-linear-gradient-background", "optional-glassmorphism", "soft-card-elevation"]
      },
      "immersive_metric": {
        "description": "Full-bleed muted blue canvas with white typography and opacity-based hierarchy; minimal color count.",
        "effects": ["monochromatic-foreground", "thin-stroke-data-viz", "glow-or-gradient-on-progress-arcs"]
      }
    },
    "density": "low-to-medium",
    "hierarchy_strategy": "Establish order through type scale, weight, and opacity before introducing additional colors.",
    "accent_strategy": "Use one neon or chartreuse accent sparingly for active states, callouts, and primary data highlights; never flood the UI with accent color."
  },
  "color_system": {
    "semantic_tokens": {
      "background": {
        "primary": { "role": "page-canvas", "light_theme": "#F9F9F4", "immersive_theme": "#7DA6D4" },
        "gradient": {
          "role": "page-canvas-variant",
          "direction": "vertical",
          "stops": [
            { "position": "0%", "hint": "warm-off-white-or-pale-lime-tint" },
            { "position": "100%", "hint": "cool-pale-grey-or-soft-blue-grey" }
          ]
        }
      },
      "surface": {
        "card": { "role": "elevated-panel", "value": "#FFFFFF", "opacity": 1 },
        "glass": { "role": "frosted-overlay", "value": "#FFFFFF", "opacity_range": [0.5, 0.8], "backdrop_blur_px": 20 },
        "muted": { "role": "secondary-panel", "value": "#F0F0EB", "opacity": 1 }
      },
      "text": {
        "primary": { "role": "headings-and-metrics", "light_theme": "#1A1A1A", "immersive_theme": "#FFFFFF" },
        "secondary": { "role": "labels-and-body", "light_theme": "#757575", "immersive_theme": "rgba(255,255,255,0.6)" },
        "tertiary": { "role": "placeholders-and-axis", "light_theme": "#A0A0A0", "immersive_theme": "rgba(255,255,255,0.4)" },
        "inverse": { "role": "text-on-accent", "value": "#1A1A1A" }
      },
      "accent": {
        "primary": { "role": "highlight-callout-active", "value": "#DFFF00", "usage": "badges, active chart segments, key percentages" },
        "secondary": { "role": "legend-dots", "values": ["#E8E8E3", "#C5C5C0", "#FFFFFF"] }
      },
      "state": {
        "positive": { "role": "uptrend", "value": "#22C55E" },
        "negative": { "role": "downtrend", "value": "#EF4444" },
        "neutral": { "role": "unchanged", "value": "#8E8E93" }
      },
      "chart": {
        "bar_inactive": { "value": "rgba(255,255,255,0.5)", "context": "light-or-glass-background" },
        "bar_active": { "token_ref": "accent.primary" },
        "ring_track": { "value": "rgba(255,255,255,0.25)", "context": "immersive-theme" },
        "ring_progress": { "value": "#FFFFFF", "context": "immersive-theme" }
      }
    },
    "contrast_targets": {
      "body_text_on_background": "WCAG AA minimum",
      "metric_on_card": "AAA preferred for primary KPIs",
      "accent_badge_text": "Dark text on neon accent for readability"
    },
    "theme_variants": [
      {
        "id": "light_analytics",
        "background_token": "background.primary.light_theme",
        "surface_token": "surface.card",
        "text_primary_token": "text.primary.light_theme"
      },
      {
        "id": "immersive_metric",
        "background_token": "background.primary.immersive_theme",
        "surface_token": null,
        "text_primary_token": "text.primary.immersive_theme"
      }
    ]
  },
  "typography_system": {
    "font_family": {
      "primary": "geometric-sans-serif",
      "fallback_stack": ["Inter", "SF Pro Display", "system-ui", "sans-serif"]
    },
    "roles": {
      "display": {
        "usage": "Hero metrics and large greeting",
        "size_px_range": [48, 72],
        "weight": 300,
        "line_height": 1.0,
        "letter_spacing": "-0.02em"
      },
      "title": {
        "usage": "Screen titles and section headers",
        "size_px_range": [24, 32],
        "weight": 600,
        "line_height": 1.2
      },
      "subtitle": {
        "usage": "Supporting lines under titles",
        "size_px_range": [14, 16],
        "weight": 400,
        "line_height": 1.5,
        "color_token": "text.secondary"
      },
      "body": {
        "usage": "Descriptions and list items",
        "size_px_range": [14, 16],
        "weight": 400,
        "line_height": 1.5
      },
      "caption": {
        "usage": "Axis labels, footnotes, metadata",
        "size_px_range": [11, 13],
        "weight": 400,
        "line_height": 1.3,
        "color_token": "text.tertiary"
      },
      "metric": {
        "usage": "KPI numbers in cards and stat blocks",
        "size_px_range": [28, 40],
        "weight": 600,
        "line_height": 1.1,
        "tabular_nums": true
      },
      "metric_large": {
        "usage": "Primary focal number on immersive screens",
        "size_px_range": [56, 80],
        "weight": 300,
        "line_height": 1.0
      },
      "label": {
        "usage": "Field labels above values",
        "size_px_range": [12, 14],
        "weight": 500,
        "text_transform": "none",
        "color_token": "text.secondary"
      },
      "badge": {
        "usage": "Pills and percentage chips",
        "size_px": 12,
        "weight": 700,
        "line_height": 1.0
      }
    },
    "hierarchy_rules": [
      "One display-level element per viewport; avoid competing hero numbers.",
      "Use weight and size before color to differentiate importance.",
      "On immersive themes, reduce secondary text via opacity rather than grey hex values.",
      "Separate thousands in metrics with thin space or standard grouping; keep unit labels smaller and lighter than the number."
    ]
  },
  "spacing_radius_stroke": {
    "spacing_scale_px": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48
    },
    "layout_margins": {
      "screen_horizontal": 20,
      "screen_vertical": 24,
      "section_gap": 24,
      "card_internal_padding": 20,
      "inline_gap": 8,
      "stack_gap_tight": 4,
      "stack_gap_default": 12
    },
    "radius_px": {
      "sm": 8,
      "md": 12,
      "lg": 20,
      "xl": 24,
      "2xl": 32,
      "pill": 9999,
      "circle": "50%"
    },
    "radius_application": {
      "screen_container": "2xl",
      "card": "xl",
      "button_icon": "md",
      "search_bar": "pill",
      "badge": "pill",
      "chart_bar_top": "sm",
      "avatar": "circle"
    },
    "stroke": {
      "icon_weight_px": 1.5,
      "ring_gauge_weight_px": 2,
      "divider_opacity": 0.15,
      "card_border": "none-or-1px-subtle-on-light-surfaces"
    },
    "elevation": {
      "card_shadow": "0 4px 24px rgba(0,0,0,0.06)",
      "glass_shadow": "0 2px 16px rgba(0,0,0,0.04)",
      "search_bar_shadow": "0 2px 8px rgba(0,0,0,0.04)"
    }
  },
  "layout_patterns": {
    "shell": {
      "safe_area": true,
      "max_content_width_behavior": "full-bleed-with-horizontal-inset",
      "scroll": "vertical-primary",
      "status_bar_style": {
        "light_theme": "dark-content",
        "immersive_theme": "light-content"
      }
    },
    "header": {
      "height_behavior": "intrinsic",
      "zones": ["leading_action", "title_optional", "trailing_action"],
      "alignment": "space-between",
      "padding_bottom": "md"
    },
    "content_zones": [
      {
        "id": "hero_block",
        "order": 1,
        "contains": ["greeting_or_title", "optional_subtitle", "primary_metric_optional"]
      },
      {
        "id": "summary_row",
        "order": 2,
        "layout": "two-column-or-horizontal-stat-pair",
        "contains": ["labeled_metric", "avatar_cluster_or_secondary_metric"]
      },
      {
        "id": "visualization_block",
        "order": 3,
        "layout": "full-width-centered",
        "contains": ["chart_or_gauge", "annotation_badge_optional"]
      },
      {
        "id": "detail_cards",
        "order": 4,
        "layout": "vertical-stack-or-2-col-grid",
        "contains": ["metric_cards", "list_with_legend", "secondary_charts"]
      },
      {
        "id": "utility_footer",
        "order": 5,
        "contains": ["search_bar_or_user_profile_row"]
      }
    ],
    "grid": {
      "metric_card_columns": 2,
      "metric_card_gap_px": 12,
      "three_column_stats": {
        "columns": 3,
        "distribution": "equal-width",
        "alignment": "center"
      }
    },
    "alignment_defaults": {
      "text": "start",
      "metrics_in_cards": "start",
      "central_gauge": "center",
      "footer_profile": "space-between"
    }
  },
  "component_blueprints": {
    "top_bar": {
      "structure": ["leading_icon_button", "optional_center_notch_spacer", "trailing_icon_button"],
      "leading": { "type": "icon_button", "icon": "back_arrow", "container": "rounded_square_glass_or_muted" },
      "trailing": { "type": "icon_button", "icon": "overflow_vertical_or_close", "container": "rounded_square_glass_or_muted" },
      "brand_row_variant": {
        "leading": { "type": "wordmark", "typography_role": "title", "trailing_punctuation_allowed": true },
        "trailing": { "type": "menu_icon", "variant": "hamburger_segmented" }
      }
    },
    "page_header": {
      "structure": ["title", "description_optional"],
      "title_typography": "title",
      "description_typography": "body",
      "description_max_lines": 3,
      "spacing_below": "lg"
    },
    "icon_button": {
      "size_px": 40,
      "radius_token": "md",
      "background": "surface.glass_or_muted",
      "icon_size_px": 20,
      "touch_target_min_px": 44
    },
    "metric_stat_block": {
      "structure": ["label", "value", "unit_optional"],
      "label_typography": "label",
      "value_typography": "metric_or_metric_large",
      "unit_typography": "subtitle",
      "layout": "vertical_stack",
      "gap": "stack_gap_tight"
    },
    "metric_card": {
      "structure": ["header_row", "value_row"],
      "header_row": ["label", "trend_badge_optional"],
      "value_typography": "metric",
      "surface": "surface.card",
      "radius_token": "xl",
      "padding_token": "card_internal_padding",
      "trend_badge": {
        "radius_token": "pill",
        "padding_horizontal_px": 8,
        "padding_vertical_px": 4,
        "typography": "badge",
        "positive_color_token": "state.positive",
        "negative_color_token": "state.negative"
      }
    },
    "avatar_cluster": {
      "structure": ["overlapping_circles", "overflow_count_circle"],
      "avatar_diameter_px": 32,
      "overlap_offset_px": -8,
      "overflow_circle": {
        "background": "surface.glass",
        "typography": "caption",
        "content_placeholder": "<additional_count>"
      }
    },
    "search_bar": {
      "structure": ["leading_icon", "input_placeholder"],
      "height_px": 48,
      "radius_token": "pill",
      "background": "surface.card_or_glass",
      "padding_horizontal_px": 16,
      "icon": "search",
      "position": "bottom_anchored_or_after_charts",
      "placeholder_typography": "caption"
    },
    "badge_pill": {
      "structure": ["text"],
      "radius_token": "pill",
      "padding_horizontal_px": 10,
      "padding_vertical_px": 4,
      "background_token": "accent.primary",
      "text_token": "text.inverse",
      "typography": "badge",
      "optional_pointer": {
        "shape": "triangle_down",
        "connects_to": "chart_element_below"
      }
    },
    "labeled_list_with_dots": {
      "structure": ["rows_of_dot_label"],
      "row": ["color_dot", "label"],
      "dot_diameter_px": 8,
      "label_typography": "caption",
      "gap": "sm"
    },
    "segmented_stat_row": {
      "structure": ["three_columns"],
      "column": ["dot_or_icon", "label", "value"],
      "alignment": "center",
      "label_typography": "caption",
      "value_typography": "metric"
    },
    "user_profile_footer": {
      "structure": ["identity_block", "utility_icon_group"],
      "identity_block": ["display_name", "email_or_secondary"],
      "display_name_typography": "body",
      "email_typography": "caption",
      "utility_icon_group": {
        "icons": ["message", "notification", "settings"],
        "layout": "horizontal",
        "gap": "md",
        "optional_container": "rounded_rectangle_glass"
      }
    },
    "chart_container_bar_vertical": {
      "structure": ["bars", "x_axis_labels", "highlight_badge_optional"],
      "bar_width_behavior": "flex_equal_with_max_width",
      "bar_radius_top_token": "sm",
      "inactive_fill_token": "chart.bar_inactive",
      "active_fill_token": "chart.bar_active",
      "axis_line": { "visible": true, "weight_px": 1, "opacity": 0.2 },
      "annotation": {
        "type": "badge_pill",
        "position": "above_active_bar"
      }
    },
    "chart_container_bar_horizontal": {
      "structure": ["segmented_track"],
      "track_height_px": 6,
      "radius_token": "pill",
      "inactive_fill": "text.tertiary",
      "active_fill_token": "accent.primary"
    },
    "radial_progress_ring": {
      "structure": ["track_ring", "progress_arc", "center_content", "connector_line_optional", "bottom_badge_optional"],
      "diameter_behavior": "large_centered_40_to_60_percent_viewport",
      "stroke_width_px": 2,
      "track_token": "chart.ring_track",
      "progress_token": "chart.ring_progress",
      "cap_style": "round",
      "center_content": {
        "primary_typography": "body",
        "content_placeholder": "<current_of_total>"
      },
      "bottom_badge": {
        "component_ref": "badge_pill",
        "position": "below_center_connected_by_vertical_line"
      }
    },
    "semi_circular_gauge": {
      "structure": ["arc_track", "arc_highlight", "center_badge", "connector_line"],
      "arc_stroke_width_px": 2,
      "badge_component_ref": "badge_pill",
      "supporting_metrics": "labeled_list_with_dots"
    }
  },
  "data_viz_language": {
    "general": [
      "Prefer thin strokes and low visual noise; charts support content rather than dominating it.",
      "Limit palette to neutrals plus one accent; use accent only on the focal data point.",
      "Avoid gridlines except minimal axis baselines.",
      "Round bar and container corners consistently with the global radius scale."
    ],
    "bar_chart_vertical": {
      "max_bars_recommended": 7,
      "highlight_strategy": "single_active_bar",
      "inactive_opacity": 0.5,
      "annotation": "pill_badge_above_active_bar"
    },
    "bar_chart_horizontal_mini": {
      "usage": "distribution_or_progress_at_card_bottom",
      "segment_style": "continuous_bar_not_gapped_columns"
    },
    "radial_and_gauge": {
      "track_style": "thin_incomplete_circle",
      "progress_style": "solid_arc_with_optional_bottom_glow",
      "center_label": "ratio_or_percentage_in_pill",
      "connector": "1px_vertical_line_from_badge_to_arc"
    },
    "legend": {
      "style": "small_filled_circles_left_of_labels",
      "position": "inline_list_or_below_title"
    },
    "trend_indicators": {
      "format": "signed_percentage",
      "placement": "top_right_of_metric_card",
      "color_tokens": {
        "up": "state.positive",
        "down": "state.negative",
        "flat": "state.neutral"
      }
    }
  },
  "interaction_motion": {
    "states": {
      "default": { "opacity": 1, "scale": 1 },
      "pressed": { "opacity": 0.85, "scale": 0.98 },
      "disabled": { "opacity": 0.4 },
      "focus": { "outline": "2px accent at 40% opacity" }
    },
    "transitions": {
      "duration_ms": { "fast": 150, "normal": 250, "slow": 400 },
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "chart_interactions": {
      "bar_select": "animate height or fill color over normal duration",
      "badge_appear": "fade_and_slide_up 150ms"
    },
    "reduced_motion": {
      "respect_prefers_reduced_motion": true,
      "fallback": "instant state change without scale or slide"
    }
  },
  "consistency_rules": {
    "do": [
      "Use one accent color per screen for focal highlights.",
      "Keep generous vertical rhythm between sections (24px+).",
      "Apply large corner radii on cards and pill shapes on chips and search.",
      "Use thin-stroke line icons matching typography weight.",
      "Left-align narrative content; center large radial visualizations.",
      "Separate KPI cards on light backgrounds with white surfaces and soft shadow.",
      "Use opacity tiers on immersive blue backgrounds instead of adding grey text colors."
    ],
    "dont": [
      "Do not mix more than two distinct background theme types on one screen.",
      "Do not use heavy borders, skeuomorphic textures, or dense gridlines.",
      "Do not place multiple competing hero metrics without clear hierarchy.",
      "Do not use saturated accent on large background areas.",
      "Do not use filled heavy icons when line icons are established.",
      "Do not crowd charts with labels; prefer external legend lists.",
      "Do not copy literal strings or numbers from reference materials."
    ]
  },
  "prompting_hints_for_ai": {
    "generation_workflow": [
      "Select theme_variant: light_analytics or immersive_metric before composing layout.",
      "Map all colors to semantic_tokens; never hardcode one-off hex values outside the token map.",
      "Build top_bar then page_header then summary_row then visualization_block then detail_cards.",
      "Assign exactly one element typography role display or metric_large per screen.",
      "Place accent.primary only on active chart segment, primary badge, or single CTA highlight."
    ],
    "screen_archetypes": {
      "reporting_overview": {
        "theme": "light_analytics",
        "zones": ["top_bar", "page_header", "summary_row", "chart_container_bar_vertical", "search_bar"],
        "effects": ["optional_glassmorphism_on_chart_area"]
      },
      "personal_performance": {
        "theme": "immersive_metric",
        "zones": ["top_bar_brand", "hero_block", "radial_progress_ring", "segmented_stat_row", "user_profile_footer"]
      },
      "analytics_dashboard": {
        "theme": "light_analytics",
        "zones": ["top_bar_brand", "metric_card_grid_2col", "labeled_list_with_dots_chart_card", "semi_circular_gauge_card"]
      }
    },
    "placeholder_conventions": {
      "title": "<screen_title>",
      "description": "<short_context_copy>",
      "metric_value": "<number>",
      "metric_unit": "<unit>",
      "user_name": "<display_name>",
      "user_email": "<email>",
      "trend_percent": "<signed_percent>",
      "chart_label": "<category>",
      "date_axis": "<date_or_period>"
    }
  },
  "anti_leak_guardrails": {
    "prohibited": [
      "Literal brand names, person names, or emails from reference screenshots",
      "Exact numeric values, percentages, or date strings from reference screenshots",
      "Exact pixel coordinates or fixed positioning copied from a single reference frame",
      "Verbatim marketing or instructional copy from reference screenshots",
      "Screenshot filenames or asset paths in generated UI copy"
    ],
    "required": [
      "Use prompting_hints_for_ai.placeholder_conventions for all user-visible strings during generation",
      "Derive layout from layout_patterns and component_blueprints, not from memorized screenshot composition",
      "Treat reference images as style inspiration only; tokens and rules in this file are the source of truth"
    ]
  },
  "usage_examples": {
    "token_reference": {
      "card_background": "color_system.semantic_tokens.surface.card",
      "highlight_color": "color_system.semantic_tokens.accent.primary",
      "hero_number_style": "typography_system.roles.metric_large"
    },
    "sample_component_payload": {
      "metric_card": {
        "label": "<category>",
        "value": "<number>",
        "trend": "<signed_percent>",
        "trend_direction": "up|down|neutral"
      },
      "radial_progress_ring": {
        "current": "<number>",
        "total": "<number>",
        "percent": "<percent>",
        "segments": [
          { "label": "<segment_a>", "value": "<number>" },
          { "label": "<segment_b>", "value": "<number>" },
          { "label": "<segment_c>", "value": "<number>" }
        ]
      }
    }
  }
}
