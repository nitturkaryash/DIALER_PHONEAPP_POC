# ============================================
# RUNTIME MODE
# ============================================

# legacy: Deepgram/Gemini STT + LLM/scripted agent + Sarvam TTS
# google-live: Gemini Live audio-to-audio websocket path
RUNTIME_FLAG=legacy

# Leave empty to use Deepgram by default.
# Set to gemini only if you want Gemini STT for telephony websockets.
STT_PROVIDER=

# Choose outbound provider selection:
# - auto: prefer Exotel when configured, otherwise LiveKit SIP
# - livekit or sip: always use LiveKit SIP
# - exotel: always use Exotel
OUTBOUND_PROVIDER=auto

USE_SCRIPTED_AGENT=0
TELEPHONY_TURN_MODE=legacy

# ============================================
# STT / REALTIME AUDIO
# ============================================

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_BASE_URL=
DEEPGRAM_SAMPLE_RATE=16000
DEEPGRAM_TELEPHONY_ENDPOINTING=500
TELEPHONY_TRANSCRIPT_DEDUPE_WINDOW_SECS=2.0

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STT_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STT_LANGUAGE_HINT=Indian English, Hindi, or mixed Hinglish

GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_LANGUAGE_CODE=en-IN
GEMINI_LIVE_INPUT_SAMPLE_RATE=16000
GEMINI_LIVE_OUTPUT_SAMPLE_RATE=24000
GEMINI_LIVE_MAX_OUTPUT_TOKENS=224
GEMINI_LIVE_SUPPRESS_INPUT_WHILE_BOT_MS=600
GEMINI_LIVE_RELEASE_AFTER_TURN_COMPLETE_MS=900
GEMINI_LIVE_ACTIVITY_HANDLING=NO_INTERRUPTION
GEMINI_LIVE_TURN_COVERAGE=TURN_INCLUDES_ONLY_ACTIVITY
GEMINI_LIVE_START_SENSITIVITY=START_SENSITIVITY_LOW
GEMINI_LIVE_END_SENSITIVITY=END_SENSITIVITY_LOW
GEMINI_LIVE_PREFIX_PADDING_MS=80
GEMINI_LIVE_SILENCE_DURATION_MS=1400
GEMINI_LIVE_ENABLE_INPUT_TRANSCRIPTION=1
GEMINI_LIVE_ENABLE_OUTPUT_TRANSCRIPTION=1
GEMINI_LIVE_TRANSCRIPTION_LANGUAGES=en-IN,hi-IN

# ============================================
# LLM
# ============================================

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ============================================
# TTS
# ============================================

SARVAM_API_KEY=
SARVAM_LANG=en-IN
SARVAM_FALLBACK_LANG=hi-IN
SARVAM_SPEAKER=shubh
SARVAM_MODEL=bulbul:v3
SARVAM_SAMPLE_RATE=
SARVAM_ENABLE_PREPROCESSING=1
SARVAM_MIN_BUFFER_SIZE=80
SARVAM_MAX_CHUNK_LENGTH=220
SARVAM_PACE=
SARVAM_PITCH=
SARVAM_LOUDNESS=
SARVAM_TEMPERATURE=

# ============================================
# CALLBACK BEHAVIOR
# ============================================

TIMEZONE=Asia/Calcutta
CALLBACK_DURATION_MIN=15
BUSINESS_HOURS_START=0
BUSINESS_HOURS_END=24
INITIAL_GREETING=Hello, this is Ravi from ELGi support. How can I help you today?
OUTBOUND_FIXED_GREETING=Hello, this is Ravi from ELGi support. Am I speaking with {customer_name}?
SYSTEM_PROMPT_FILE=prompts/system.txt
LOG_INTERIM_TRANSCRIPTS=0
PIPECAT_ENABLE_METRICS=0

# ============================================
# EXOTEL INBOUND / OUTBOUND
# ============================================

EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Optional legacy fallback names still supported by outbound_call_service.
EXOTEL_BASIC_USER=
EXOTEL_BASIC_TOKEN=

EXOTEL_CALLER_ID=
EXOTEL_FLOW_URL=
EXOTEL_APP_ID=
EXOTEL_API_BASE_URL=https://api.exotel.com
EXOTEL_FLOW_BASE_URL=
EXOTEL_CALL_TYPE=trans
EXOTEL_STATUS_CALLBACK=

# Optional Basic Auth for the Exotel websocket route.
EXOTEL_WS_BASIC_USER=
EXOTEL_WS_BASIC_TOKEN=

# Exotel media bridge tuning
EXOTEL_PIPELINE_SAMPLE_RATE=8000
EXOTEL_AUDIO_10MS_CHUNKS=10

# ============================================
# LIVEKIT SIP / TELNYX
# ============================================

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_NUMBER=
# Optional PBX access prefix for LiveKit trunks connected to Issabel (e.g. 3680).
# Leave empty/unset for carrier trunks like Telnyx.
LIVEKIT_SIP_DIAL_PREFIX=

# Human agent dialer: use direct Issabel SIP from this backend (VPN) instead of LiveKit Cloud SIP.
# Auto-enabled when ISSABEL_SIP_HOST is a private IP (10.x / 172.x / 192.168.x).
HUMAN_AGENT_USE_ISSABEL_DIRECT=

# Optional legacy fallback used by the LiveKit SIP request builder.
TELNYX_OUTBOUND_NUMBER=
TELNYX_API_KEY=

# Warm bot pool for faster LiveKit SIP answers.
WARM_BOT_POOL_ENABLED=0
WARM_BOT_POOL_SIZE=1
WARM_BOT_IDLE_TTL_SECS=90

# Retain completed call state in memory briefly for status polling before evicting it.
COMPLETED_CALL_TTL_SECS=30

# ============================================
# ISSABEL DIRECT SIP
# ============================================

ISSABEL_SIP_HOST=
ISSABEL_SIP_PORT=5060
ISSABEL_SIP_USER=
ISSABEL_SIP_LOGIN=
ISSABEL_SIP_DOMAIN=
ISSABEL_SIP_PASSWORD=
ISSABEL_SIP_DIAL_PREFIX=3680
ISSABEL_PIPELINE_SAMPLE_RATE=16000
ISSABEL_RTP_PARTIAL_FLUSH_MS=60
ISSABEL_RTP_IDLE_HANGUP_SECS=20
ISSABEL_INVITE_TIMEOUT=45
ISSABEL_LOG_RTP_STATS=1

# ============================================
# MONGO / AUTH
# ============================================

MONGO_URI=
MONGO_DB_NAME=voice_assistant
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ISSUER=voice-assistant-api
JWT_AUDIENCE=voice-assistant-clients
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=14
AUTH_DEFAULT_ADMIN_EMAIL=admin@example.com
AUTH_DEFAULT_ADMIN_PASSWORD=Admin@12345
AUTH_PASSWORD_SALT=voice-assistant-salt

# ============================================
# KNOWLEDGE
# ============================================

KNOWLEDGE_EMBED_MODEL=gemini-embedding-2-preview
KNOWLEDGE_PDF_PAGES_PER_CHUNK=6
KNOWLEDGE_EMBED_TIMEOUT_SECS=45
KNOWLEDGE_QUERY_EMBED_TIMEOUT_SECS=15
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHUNK_CHARS=650

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

GOOGLE_CALENDAR_ID=primary
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
